# Application Environment Variables
PORT=5000
NODE_ENV=development

# Cors Configuration
CORS_ORIGIN=http://localhost:4000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true

# Database Configuration
# Replace the following values with your actual database credentials
DATABASE_URL='postgres://username:password@localhost:5432/databasename'
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=databasename
DATABASE_USER=job_username
DATABASE_PASSWORD=password

# Clerk Configuration
# Add your Clerk API keys here
CLERK_PUBLISHABLE_KEY='your-publishable-key'
CLERK_SECRET_KEY='your-secret-key'


# AWS S3 Configuration
AWS_REGION='region-name'
AWS_ACCESS_KEY_ID='your-access-key-id'
AWS_SECRET_ACCESS_KEY='your-secret-access-key'
S3_BUCKET_NAME='your-s3-bucket-name'
SIGNED_URL_EXPIRATION=60*2 # 2 minutes

GOOGLE_CLIENT_ID='your-google-client-id'
GOOGLE_CLIENT_SECRET='your-google-client-secret'
GOOGLE_REDIRECT_URI='http://localhost:4000/auth/social/youtube/callback'